# ---- LLM extraction (OpenRouter, OpenAI-compatible) ----
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EXTRACTION_DPI=150
# EXTRACTION_MAX_PAGES=8

# ---- Storage (leave DATABASE_URL empty to use local sqlite) ----
# Supabase -> Project Settings -> Database -> Connection string (URI, "Session"/port 5432)
DATABASE_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>
SUPABASE_BUCKET=policy-pdfs

# ---- CORS: the deployed frontend origin(s), comma-separated ----
CORS_ORIGINS=https://insurance-rater-agent.vercel.app,http://localhost:5173
